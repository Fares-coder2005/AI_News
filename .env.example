# AI Weekly Digest - Environment Variables
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to version control

# OpenRouter API key for LLM curation
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: override the model (default: nvidia/nemotron-3-ultra-550b-a55b:free)
# MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Telegram bot credentials (for delivery + error alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_TO=recipient@example.com
EMAIL_FROM=sender@example.com
