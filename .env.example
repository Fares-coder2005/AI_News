# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Required for curation
GEMINI_API_KEY=

# Telegram (for delivery + error alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
EMAIL_FROM=

# Optional: override LLM model (default: gemma-4-31b-it)
# MODEL=gemini-2.0-flash

# Optional: Discord webhook for error fallback
# DISCORD_WEBHOOK_URL=